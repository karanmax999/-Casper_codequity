# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_AUTH_REDIRECT_ORIGIN=http://localhost:3000

# Backend API (where codequity-analytics is running)
BACKEND_URL=http://localhost:8000

# Admin API Key (for server actions only; keep secret)
ADMIN_API_KEY=your_admin_api_key_here

# Casper testnet
NEXT_PUBLIC_CASPER_CHAIN_NAME=casper-test
NEXT_PUBLIC_CASPER_RPC_URL=https://node.testnet.casper.network/rpc
NEXT_PUBLIC_CASPER_ESCROW_PUBLIC_KEY=01<64_hex_escrow_or_agent_public_key>
